---
export interface ToolCard {
	title: string;
	desc: string;
	anchorText: string;
	anchorLink: string;
	image: string;
	// Автор и лицензия обложки, если они требуются
	credit?: string;
}

interface Props {
	cards: ToolCard[];
}

const { cards } = Astro.props;
---

<ul>
	{
		cards.map((card) => (
			<li>
				<div>
					<img src={card.image} alt={card.title} />
					<div class="general-info">
						<div class="general-info__inner">
							<h3>{card.title}</h3>
							<div>{card.desc}</div>
						</div>
						<a href={card.anchorLink} class="text-white text-base font-medium text-center inline-flex items-center justify-center bg-gradient-to-br from-pink-500 to-orange-400 hover:bg-gradient-to-bl focus:ring-4 focus:outline-none focus:ring-pink-200 dark:focus:ring-pink-800 rounded-lg px-9 py-3">
							{card.anchorText}
						</a>
						{card.credit && <small class="credit">Фото: {card.credit}</small>}
					</div>
				</div>
			</li>
		))
	}
</ul>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		width: 100%;
	}
	ul li * {
		text-decoration: none;
		transition: 0.2s ease;
	}
	ul li > div {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
	}
	ul li img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		border-radius: 0;
	}
	ul li .general-info {
		position: relative;
		z-index: 2;
		padding: 1em;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1em;
		background-color: rgba(0, 0, 0, 0.65);
	}
	ul li .general-info__inner :is(h3, div) {
		margin-bottom: 0;
		color: #fff;
		text-align: left;
	}
	ul li .credit {
		position: absolute;
		right: 0.75em;
		bottom: 0.5em;
		font-size: 0.65rem;
		color: rgba(255, 255, 255, 0.7);
	}
	ul li .general-info :is(a:hover, a:active) {
		color: #fff;
	}
	@media (max-width: 720px) {
		ul {
			gap: 1.5em;
		}
	}
</style>
