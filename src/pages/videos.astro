---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import YouTubeChannel from '../components/YouTubeChannel.astro';
import { getChannel } from '../lib/youtube';

const channels = await Promise.all([
	getChannel('@encyklop', 'videos'),
	getChannel('@a_klinichev', 'streams'),
]);
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title="Видео" description="Видео с канала Энциклоп и стримы с канала Энциклоп (стримы и личное). В основном про языки, но иногда ещё и про историю с географией" />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="min-[721px]:pt-8">
			<section class="text-center mb-8">
				<h1 class="font-display">Видео</h1>
			</section>
			{channels.map((channel) => channel && <YouTubeChannel channel={channel} />)}
		</main>
		<Footer />
	</body>
</html>
