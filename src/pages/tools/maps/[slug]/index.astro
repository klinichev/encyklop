---
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import PointsMap from '../../../../components/PointsMap';
import 'maplibre-gl/dist/maplibre-gl.css';
import { WEB_APP_SCHEMA } from '../../../../consts';
import { pointMapPaths } from '../../../../lib/pointMaps';

export const getStaticPaths = pointMapPaths;

const { map } = Astro.props as { map: CollectionEntry<'pointMaps'> };
const { title, description, lead, cover, filter, pointNoun, note } = map.data;
---

<Layout
  title={title}
  description={description}
  image={cover}
  schema={{ ...WEB_APP_SCHEMA, name: title, applicationCategory: 'EducationalApplication' }}
>
  <section class="text-center mb-6">
    <h1 class="font-display mb-2">{title}</h1>
    <p>{lead}</p>
  </section>
  <PointsMap client:only="react" dataUrl={`/tools/maps/${map.id}/points.json`} filter={filter} pointNoun={pointNoun} note={note} />
</Layout>

<style>
  @media (max-width: 720px) {
    h1 {
      font-size: 8vw;
    }
  }
</style>
