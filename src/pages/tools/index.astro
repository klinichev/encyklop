---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCards from '../../components/ToolCards.astro';
import type { ToolCard } from '../../components/ToolCards.astro';
import { POINT_MAPS_SECTION } from '../../consts';

const actionCards: ToolCard[] = [{
	title: 'Гео-линейка',
	desc: 'Линии широты и долготы и окружности нужного радиуса на карте мира',
	anchorText: 'Открыть',
	anchorLink: '/tools/geo-lines/',
	image: '/old-map.webp'
}, {
	title: POINT_MAPS_SECTION.title,
	desc: POINT_MAPS_SECTION.description,
	anchorText: 'Открыть',
	anchorLink: '/tools/maps/',
	image: POINT_MAPS_SECTION.image,
	credit: POINT_MAPS_SECTION.imageCredit
}];
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title="Полезности" description="Полезные инструменты для работы с картой мира" schema={{ "@type": "CollectionPage" }} />
		<style>
			main {
				width: 960px;
			}
			@media (max-width: 400px) {
				h1 {
					font-size: 14vw;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="min-[721px]:pt-8">
			<section class="text-center mb-8">
				<h1 class="font-display">Полезности</h1>
			</section>
			<section>
				<ToolCards cards={actionCards} />
			</section>
		</main>
		<Footer />
	</body>
</html>
