---
import Layout from '../../../layouts/Layout.astro';
import GeoLines from '../../../components/GeoLines';
import 'leaflet/dist/leaflet.css';
---

<Layout
  title="Гео-линейка"
  description="Нарисуйте на карте мира линию широты, линию долготы или окружность нужного радиуса вокруг любой точки"
>
  <section class="text-center mb-8">
    <h1 class="font-display mb-2">Гео-линейка</h1>
    <p>Выберите место и нажмите на него на карте</p>
  </section>
  <GeoLines client:only="react" />
</Layout>

<style>
  @media (max-width: 440px) {
    h1 {
      font-size: 13vw;
    }
  }
</style>
